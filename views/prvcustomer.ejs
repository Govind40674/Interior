<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <!-- <title>Previous-Reviews</title> -->
     <title>MW Studio || Previous-Reviews</title>
  <link rel="icon" href="/images/title.png" type="image/png" />
  <link rel="stylesheet" href="/prvcustomer.css">
</head>
<body>
    <div id="preloader">
  <div class="loader">
    <!-- <img src="/images/about us.png" alt="Your Website Logo" /> -->
    <img src="/images/loading.svg" alt="Loading Animation" />
  </div>
</div>
  <h1>Previous-Services</h1>
   <div class="container">
    <div class="image">
      <img src="/images/darklogo.png" alt="logo">
    </div>
  </div>

  <!-- Navigation -->
  <div class="content">
    <a href="/">Home</a>
    <a href="/about">About</a>
    <a href="/services">Services</a>
    <a href="/contact">Contact</a>
    <a href="/admin">Admin</a>
  </div>
  <%for(let data of data1){%>
  <div class="services-container">
    <img src="<%= data.image %>" alt="logo">
    <h3><%= data.name %></h3>
    <p><%= data.review %></p>
    <a href="/reviews-delete/<%= data._id %>">Delete</a>

  </div>
  <%}%>


  
</body>
<script>
  // Hide preloader when page fully loads
  window.addEventListener("load", function() {
    const preloader = document.getElementById("preloader");
    preloader.style.display = "none";
  });
